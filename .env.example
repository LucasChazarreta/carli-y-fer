# SERVER secrets: configure inside Supabase Edge Functions > Secrets.
# Do not put these values into public/config.js or commit a completed .env file.
WEDDING_GUEST_CODE=
WEDDING_RATE_SALT=
WEDDING_ALLOWED_ORIGINS=https://lucaschazarreta.github.io,https://boda-carli-fer.agentslucca.online

# Optional dedicated encryption key; set BEFORE issuing invitations if used.
# Otherwise V2 derives from the automatic service role secret + WEDDING_RATE_SALT.
WEDDING_INVITATION_SECRET=
# Disabled by default; only for an explicit temporary legacy transition.
WEDDING_ALLOW_LEGACY_CODE=false
